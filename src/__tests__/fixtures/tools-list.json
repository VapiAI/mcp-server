[
  {
    "name": "create_assistant",
    "description": "Creates a new Vapi assistant",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "firstMessage": {
          "default": "Hello, how can I help you today?",
          "description": "First message to say to the user",
          "type": "string"
        },
        "firstMessageMode": {
          "default": "assistant-speaks-first",
          "description": "This determines who speaks first, either assistant or user",
          "enum": [
            "assistant-speaks-first",
            "assistant-waits-for-user",
            "assistant-speaks-first-with-model-generated-message"
          ],
          "type": "string"
        },
        "instructions": {
          "default": "You are a helpful assistant.",
          "description": "Instructions for the assistant",
          "type": "string"
        },
        "llm": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "properties": {
                    "model": {
                      "enum": [
                        "gpt-4o",
                        "gpt-4o-mini"
                      ],
                      "type": "string"
                    },
                    "provider": {
                      "const": "openai",
                      "type": "string"
                    }
                  },
                  "required": [
                    "provider",
                    "model"
                  ],
                  "type": "object"
                },
                {
                  "properties": {
                    "model": {
                      "enum": [
                        "claude-3-7-sonnet-20250219",
                        "claude-3-5-haiku-20241022"
                      ],
                      "type": "string"
                    },
                    "provider": {
                      "const": "anthropic",
                      "type": "string"
                    }
                  },
                  "required": [
                    "provider",
                    "model"
                  ],
                  "type": "object"
                },
                {
                  "properties": {
                    "model": {
                      "enum": [
                        "gemini-1.5-pro",
                        "gemini-1.5-flash",
                        "gemini-2.0-flash",
                        "gemini-2.0-pro"
                      ],
                      "type": "string"
                    },
                    "provider": {
                      "const": "google",
                      "type": "string"
                    }
                  },
                  "required": [
                    "provider",
                    "model"
                  ],
                  "type": "object"
                },
                {
                  "properties": {
                    "model": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "provider",
                    "model"
                  ],
                  "type": "object"
                }
              ]
            },
            {
              "type": "string"
            }
          ],
          "description": "LLM configuration"
        },
        "name": {
          "description": "Name of the assistant",
          "type": "string"
        },
        "toolIds": {
          "description": "IDs of tools to use with this assistant",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "transcriber": {
          "default": {
            "model": "nova-3",
            "provider": "deepgram"
          },
          "description": "Transcription configuration",
          "properties": {
            "model": {
              "description": "Transcription model to use",
              "type": "string"
            },
            "provider": {
              "description": "Provider to use for transcription",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "type": "object"
        },
        "voice": {
          "default": {
            "provider": "11labs",
            "voiceId": "sarah"
          },
          "description": "Voice configuration",
          "properties": {
            "model": {
              "description": "Voice model to use",
              "type": "string"
            },
            "provider": {
              "description": "Provider to use for voice",
              "enum": [
                "vapi",
                "11labs",
                "azure",
                "cartesia",
                "custom-voice",
                "deepgram",
                "hume",
                "lmnt",
                "neuphonic",
                "openai",
                "playht",
                "rime-ai",
                "smallest-ai",
                "tavus",
                "sesame"
              ],
              "type": "string"
            },
            "voiceId": {
              "description": "Voice ID to use",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "voiceId"
          ],
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_call",
    "description": "Creates a outbound call",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "assistantId": {
          "description": "ID of the assistant to use for the call",
          "type": "string"
        },
        "assistantOverrides": {
          "description": "Overrides for the assistant configuration",
          "properties": {
            "variableValues": {
              "additionalProperties": {},
              "description": "Key-value pairs for dynamic variables to use in the assistant's prompts (e.g. {\"name\": \"Joe\", \"age\": \"24\"})",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "customer": {
          "description": "Customer information",
          "properties": {
            "number": {
              "description": "Customer phone number",
              "type": "string"
            }
          },
          "required": [
            "number"
          ],
          "type": "object"
        },
        "phoneNumberId": {
          "description": "ID of the phone number to use for the call",
          "type": "string"
        },
        "scheduledAt": {
          "description": "ISO datetime string for when the call should be scheduled (e.g. \"2025-03-25T22:39:27.771Z\")",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
