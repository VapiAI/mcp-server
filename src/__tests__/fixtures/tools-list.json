[
  {
    "name": "ask_vapi_docs",
    "description": "Ask about current Vapi documentation through the Fern docs MCP. Returns relevant documentation passages and source URLs; use them to answer the question.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "question": {
          "description": "A specific question about Vapi configuration, APIs, SDKs or troubleshooting. Send no API keys or private customer data.",
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        "topK": {
          "default": 8,
          "description": "Maximum number of relevant documentation passages.",
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "question"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_assistant",
    "description": "Creates a new Vapi assistant",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": {},
      "properties": {
        "firstMessage": {
          "default": "Hello, how can I help you today?",
          "description": "First message to say to the user",
          "type": "string"
        },
        "firstMessageMode": {
          "default": "assistant-speaks-first",
          "description": "This determines who speaks first, either assistant or user",
          "enum": [
            "assistant-speaks-first",
            "assistant-speaks-first-with-model-generated-message",
            "assistant-waits-for-user"
          ],
          "type": "string"
        },
        "instructions": {
          "default": "You are a helpful assistant.",
          "description": "Instructions for the assistant",
          "maxLength": 100000000,
          "type": "string"
        },
        "llm": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string"
                },
                "provider": {
                  "type": "string"
                }
              },
              "required": [
                "provider"
              ],
              "type": "object"
            },
            {
              "type": "string"
            }
          ],
          "description": "LLM configuration"
        },
        "name": {
          "description": "Name of the assistant",
          "maxLength": 40,
          "type": "string"
        },
        "toolIds": {
          "description": "IDs of tools to use with this assistant",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "transcriber": {
          "additionalProperties": false,
          "description": "Transcription configuration",
          "properties": {
            "model": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "provider"
          ],
          "type": "object"
        },
        "voice": {
          "additionalProperties": false,
          "description": "Voice configuration",
          "properties": {
            "model": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "voiceId": {
              "type": "string"
            }
          },
          "required": [
            "provider",
            "voiceId"
          ],
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_call",
    "description": "Creates a outbound call",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": {},
      "properties": {
        "assistantId": {
          "description": "ID of the assistant to use for the call",
          "type": "string"
        },
        "assistantOverrides": {
          "description": "Overrides for the assistant configuration",
          "properties": {
            "variableValues": {
              "additionalProperties": {},
              "description": "Key-value pairs for dynamic variables to use in the assistant's prompts (e.g. {\"name\": \"Joe\", \"age\": \"24\"})",
              "properties": {},
              "type": "object"
            }
          },
          "type": "object"
        },
        "customer": {
          "description": "Customer information",
          "properties": {
            "number": {
              "description": "Customer phone number",
              "maxLength": 40,
              "minLength": 3,
              "type": "string"
            }
          },
          "required": [
            "number"
          ],
          "type": "object"
        },
        "phoneNumberId": {
          "description": "ID of the phone number to use for the call",
          "type": "string"
        },
        "scheduledAt": {
          "description": "ISO datetime string for when the call should be scheduled (e.g. \"2025-03-25T22:39:27.771Z\")",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "create_tool",
    "description": "Creates a new Vapi tool",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": {},
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "apiRequest"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "apiRequest"
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "function"
                ]
              },
              {
                "properties": {
                  "description": {
                    "minLength": 1
                  }
                },
                "required": [
                  "description"
                ]
              }
            ],
            "properties": {
              "type": {
                "const": "function"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "name"
            ]
          }
        }
      ],
      "properties": {
        "additionalFields": {
          "additionalProperties": {},
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "apiRequest": {
          "description": "API Request tool configuration - for HTTP API integration",
          "properties": {
            "backoffPlan": {
              "description": "Retry configuration for failed API requests",
              "properties": {
                "baseDelaySeconds": {
                  "default": 1,
                  "description": "Base delay between retries in seconds",
                  "maximum": 10,
                  "minimum": 0,
                  "type": "number"
                },
                "maxRetries": {
                  "default": 3,
                  "description": "Maximum number of retries",
                  "maximum": 10,
                  "minimum": 0,
                  "type": "number"
                },
                "type": {
                  "default": "fixed",
                  "description": "This is the type of backoff plan to use. Defaults to fixed.\n\n@default fixed",
                  "enum": [
                    "fixed",
                    "exponential"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            "body": {
              "description": "Body schema for the API request in JSON Schema format",
              "properties": {
                "description": {
                  "description": "This is the description to help the model understand what it needs to output.",
                  "type": "string"
                },
                "enum": {
                  "description": "This array specifies the allowed values that can be used to restrict the output of the model.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "format": {
                  "type": "string"
                },
                "items": {},
                "pattern": {
                  "type": "string"
                },
                "properties": {
                  "additionalProperties": {
                    "allOf": [
                      {}
                    ]
                  },
                  "description": "This is required if the type is \"object\". This specifies the properties of the object. This is a map of property names to JsonSchema objects.",
                  "properties": {},
                  "type": "object"
                },
                "required": {
                  "description": "This is a list of properties that are required.\n\nThis only makes sense if the type is \"object\".",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "title": {
                  "description": "This is the title of the schema.",
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "array",
                    "object"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            "headers": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Headers to send with the request (key-value pairs)",
              "properties": {},
              "type": "object"
            },
            "method": {
              "default": "POST",
              "description": "HTTP method for the API request",
              "enum": [
                "POST",
                "GET",
                "PUT",
                "PATCH",
                "DELETE"
              ],
              "type": "string"
            },
            "timeoutSeconds": {
              "default": 20,
              "description": "Request timeout in seconds",
              "maximum": 300,
              "minimum": 1,
              "type": "number"
            },
            "url": {
              "description": "URL to make the API request to",
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "type": "object"
        },
        "description": {
          "description": "Description of what the function/tool does",
          "type": "string"
        },
        "function": {
          "description": "Custom function tool configuration - for custom server-side functions",
          "properties": {
            "parameters": {
              "description": "JSON schema for function parameters",
              "properties": {
                "properties": {
                  "additionalProperties": {},
                  "properties": {},
                  "type": "object"
                },
                "required": {
                  "description": "This specifies the properties that are required by the function.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": {
                  "const": "object",
                  "description": "This must be set to 'object'. It instructs the model to return a JSON object containing the function call properties.",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "properties"
              ],
              "type": "object"
            },
            "server": {
              "description": "Server configuration with URL where the function will be called",
              "properties": {
                "headers": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Headers to send with the request",
                  "properties": {},
                  "type": "object"
                },
                "url": {
                  "description": "Server URL where the function will be called",
                  "format": "uri",
                  "type": "string"
                }
              },
              "required": [
                "url"
              ],
              "type": "object"
            }
          },
          "required": [
            "parameters",
            "server"
          ],
          "type": "object"
        },
        "name": {
          "description": "Name of the function/tool",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "type": "string"
        },
        "sms": {
          "description": "SMS tool configuration - to send text messages",
          "properties": {
            "metadata": {
              "description": "SMS configuration metadata",
              "properties": {
                "from": {
                  "description": "Phone number to send SMS from (e.g., \"+15551234567\"). It must be a twilio number in E.164 format.",
                  "type": "string"
                }
              },
              "required": [
                "from"
              ],
              "type": "object"
            }
          },
          "required": [
            "metadata"
          ],
          "type": "object"
        },
        "transferCall": {
          "description": "Transfer call tool configuration - to transfer calls to destinations",
          "properties": {
            "destinations": {
              "description": "Array of possible transfer destinations",
              "items": {
                "additionalProperties": {},
                "description": "Transfer destination. Other TransferDestinationNumber fields, such as transferPlan and message, are sent as given (see get_api_schema).",
                "properties": {
                  "callerId": {
                    "maxLength": 40,
                    "type": "string"
                  },
                  "description": {
                    "description": "This is the description of the destination, used by the AI to choose when and how to transfer the call.",
                    "type": "string"
                  },
                  "extension": {
                    "description": "This is the extension to dial after transferring the call to the `number`.",
                    "maxLength": 10,
                    "minLength": 1,
                    "type": "string"
                  },
                  "number": {
                    "description": "This is the phone number to transfer the call to.",
                    "maxLength": 40,
                    "minLength": 3,
                    "type": "string"
                  },
                  "type": {
                    "const": "number",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "number"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "destinations"
          ],
          "type": "object"
        },
        "type": {
          "anyOf": [
            {
              "const": "sms",
              "description": "The type of tool. \"sms\" for Twilio SMS sending tool.",
              "type": "string"
            },
            {
              "const": "transferCall",
              "type": "string"
            },
            {
              "const": "function",
              "description": "The type of tool. \"function\" for Function tool.",
              "type": "string"
            },
            {
              "const": "apiRequest",
              "description": "The type of tool. \"apiRequest\" for API request tool.",
              "type": "string"
            }
          ],
          "description": "Type of the tool to create"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  },
  {
    "name": "get_api_schema",
    "description": "Looks up a schema in the Vapi API reference (the OpenAPI spec the Vapi SDKs are generated from). Pass `search` to find schema names, then `name` to get one schema. References to other schemas are left as \"#/components/schemas/<Name>\" and listed in referencedSchemas, so look those up next if you need them. Use it to find fields that other tools accept through additionalFields.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "name": {
          "description": "Exact schema name to return, e.g. \"CreateTransferCallToolDTO\" or \"TransferPlan\"",
          "type": "string"
        },
        "search": {
          "description": "Case-insensitive text to find schema names, e.g. \"transfer\". Used when name is not given.",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "get_assistant",
    "description": "Gets a Vapi assistant by ID",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": {},
      "properties": {
        "assistantId": {
          "description": "ID of the assistant to get",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        }
      },
      "required": [
        "assistantId"
      ],
      "type": "object"
    }
  },
  {
    "name": "get_call",
