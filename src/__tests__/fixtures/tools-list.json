          ],
          "description": "New LLM configuration"
        },
        "name": {
          "description": "New name for the assistant",
          "maxLength": 40,
          "type": "string"
        },
        "toolIds": {
          "description": "New IDs of tools to use with this assistant",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "transcriber": {
          "additionalProperties": false,
          "description": "New transcription configuration",
          "properties": {
            "model": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "provider"
          ],
          "type": "object"
        },
        "voice": {
          "additionalProperties": false,
          "description": "New voice configuration",
          "properties": {
            "model": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "voiceId": {
              "type": "string"
            }
          },
          "required": [
            "provider",
            "voiceId"
          ],
          "type": "object"
        }
      },
      "required": [
        "assistantId"
      ],
      "type": "object"
    }
  },
  {
    "name": "update_tool",
    "description": "Updates an existing Vapi tool",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": {},
      "properties": {
        "additionalFields": {
          "additionalProperties": {},
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "apiRequest": {
          "description": "API Request tool configuration - for HTTP API integration",
          "properties": {
            "backoffPlan": {
              "description": "Retry configuration for failed API requests",
              "properties": {
                "baseDelaySeconds": {
                  "default": 1,
                  "description": "Base delay between retries in seconds",
                  "maximum": 10,
                  "minimum": 0,
                  "type": "number"
                },
                "maxRetries": {
                  "default": 3,
                  "description": "Maximum number of retries",
                  "maximum": 10,
                  "minimum": 0,
                  "type": "number"
                },
