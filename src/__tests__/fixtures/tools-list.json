          "type": "string"
        },
        "instructions": {
          "description": "New instructions for the assistant",
          "type": "string"
        },
        "llm": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "model": {
                      "enum": [
                        "gpt-4o",
                        "gpt-4o-mini"
                      ],
                      "type": "string"
                    },
                    "provider": {
                      "const": "openai",
                      "type": "string"
