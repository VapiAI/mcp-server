    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": {},
      "properties": {
        "assistantId": {
          "description": "ID of the assistant to update",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        "firstMessage": {
          "description": "First message to say to the user",
          "type": "string"
        },
        "firstMessageMode": {
          "description": "This determines who speaks first, either assistant or user",
          "enum": [
            "assistant-speaks-first",
            "assistant-speaks-first-with-model-generated-message",
            "assistant-waits-for-user"
          ],
          "type": "string"
        },
        "instructions": {
          "description": "New instructions for the assistant",
          "maxLength": 100000000,
          "type": "string"
        },
        "llm": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string"
                },
                "provider": {
                  "type": "string"
                }
              },
              "required": [
                "provider"
              ],
              "type": "object"
            },
            {
              "type": "string"
