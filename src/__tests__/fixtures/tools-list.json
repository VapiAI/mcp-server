[
  {
    "name": "create_assistant",
    "description": "Creates a new Vapi assistant",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "firstMessage": {
          "default": "Hello, how can I help you today?",
          "description": "First message to say to the user",
          "type": "string"
        },
        "firstMessageMode": {
          "default": "assistant-speaks-first",
          "description": "This determines who speaks first, either assistant or user",
          "enum": [
            "assistant-speaks-first",
            "assistant-waits-for-user",
            "assistant-speaks-first-with-model-generated-message"
          ],
          "type": "string"
        },
        "instructions": {
          "default": "You are a helpful assistant.",
          "description": "Instructions for the assistant",
          "type": "string"
        },
        "llm": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "model": {
                      "enum": [
                        "gpt-4o",
                        "gpt-4o-mini"
                      ],
                      "type": "string"
                    },
                    "provider": {
                      "const": "openai",
                      "type": "string"
                    }
                  },
                  "required": [
                    "provider",
                    "model"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "model": {
                      "enum": [
                        "claude-3-7-sonnet-20250219",
                        "claude-3-5-haiku-20241022"
                      ],
                      "type": "string"
                    },
                    "provider": {
                      "const": "anthropic",
                      "type": "string"
                    }
                  },
                  "required": [
                    "provider",
                    "model"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "model": {
                      "enum": [
                        "gemini-1.5-pro",
                        "gemini-1.5-flash",
                        "gemini-2.0-flash",
                        "gemini-2.0-pro"
                      ],
                      "type": "string"
                    },
                    "provider": {
                      "const": "google",
                      "type": "string"
                    }
                  },
                  "required": [
                    "provider",
                    "model"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "model": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "provider",
                    "model"
                  ],
                  "type": "object"
                }
              ]
            },
            {
              "type": "string"
            }
          ],
          "default": {
            "model": "gpt-4o",
            "provider": "openai"
          },
          "description": "LLM configuration"
        },
        "name": {
          "description": "Name of the assistant",
          "type": "string"
        },
        "toolIds": {
          "description": "IDs of tools to use with this assistant",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "transcriber": {
          "additionalProperties": false,
          "default": {
            "model": "nova-3",
            "provider": "deepgram"
          },
          "description": "Transcription configuration",
          "properties": {
            "model": {
              "description": "Transcription model to use",
              "type": "string"
            },
            "provider": {
              "description": "Provider to use for transcription",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "type": "object"
        },
        "voice": {
          "additionalProperties": false,
          "default": {
            "provider": "11labs",
            "voiceId": "sarah"
          },
          "description": "Voice configuration",
          "properties": {
            "model": {
              "description": "Voice model to use",
              "type": "string"
            },
            "provider": {
              "description": "Provider to use for voice",
              "enum": [
                "vapi",
                "11labs",
                "azure",
                "cartesia",
                "custom-voice",
                "deepgram",
                "11labs",
                "hume",
                "lmnt",
                "neuphonic",
                "openai",
                "playht",
                "rime-ai",
                "smallest-ai",
                "tavus",
                "sesame"
              ],
              "type": "string"
            },
            "voiceId": {
              "description": "Voice ID to use",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "voiceId"
          ],
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_call",
    "description": "Creates a outbound call",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "assistantId": {
          "description": "ID of the assistant to use for the call",
          "type": "string"
        },
        "assistantOverrides": {
          "additionalProperties": false,
          "description": "Overrides for the assistant configuration",
          "properties": {
            "variableValues": {
              "additionalProperties": {},
              "description": "Key-value pairs for dynamic variables to use in the assistant's prompts (e.g. {\"name\": \"Joe\", \"age\": \"24\"})",
              "type": "object"
            }
          },
          "type": "object"
        },
        "customer": {
          "additionalProperties": false,
          "description": "Customer information",
          "properties": {
            "number": {
              "description": "Customer phone number",
              "type": "string"
            }
          },
          "required": [
            "number"
          ],
          "type": "object"
        },
        "phoneNumberId": {
          "description": "ID of the phone number to use for the call",
          "type": "string"
        },
        "scheduledAt": {
          "description": "ISO datetime string for when the call should be scheduled (e.g. \"2025-03-25T22:39:27.771Z\")",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "create_simulation",
    "description": "Creates a simulation that pairs a scenario with a personality. Run it with run_simulations.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Optional name for the simulation",
          "type": "string"
        },
        "path": {
          "description": "Optional folder path for organizing, up to 3 levels (e.g. \"team/feature/variant\")",
          "type": "string"
        },
        "personalityId": {
          "description": "ID of the personality to use",
          "type": "string"
        },
        "scenarioId": {
          "description": "ID of the scenario to use",
          "type": "string"
        }
      },
      "required": [
        "scenarioId",
        "personalityId"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_simulation_personality",
    "description": "Creates a simulation personality: the simulated caller that talks to the assistant under test",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "assistant": {
          "additionalProperties": {},
          "description": "The tester's full assistant configuration: its voice, model, and behavior, such as model.messages with the persona prompt. Same shape as create_assistant in the Vapi API (get_api_schema: CreateAssistantDTO).",
          "type": "object"
        },
        "name": {
          "description": "Name of the personality (e.g. \"Confused Carl\", \"Rude Rob\")",
          "type": "string"
        },
        "path": {
          "description": "Optional folder path for organizing, up to 3 levels (e.g. \"team/feature/variant\")",
          "type": "string"
        }
      },
      "required": [
        "name",
        "assistant"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_simulation_scenario",
    "description": "Creates a simulation scenario: instructions for the tester plus evaluations that decide whether the assistant passed",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "additionalFields": {
          "additionalProperties": {},
          "description": "Other fields from the Vapi API, sent as given. Look them up with get_api_schema (CreateScenarioDTO).",
          "type": "object"
        },
        "evaluations": {
          "description": "Structured-output checks that decide whether the simulation passed (get_api_schema: EvaluationPlanItem)",
          "items": {
            "additionalProperties": true,
            "properties": {
              "comparator": {
                "description": "How to compare the extracted value with value",
                "enum": [
                  "=",
                  "!=",
                  ">",
                  "<",
                  ">=",
                  "<="
                ],
                "type": "string"
              },
              "required": {
                "description": "Whether this evaluation must pass for the simulation to pass (default true)",
                "type": "boolean"
              },
              "structuredOutput": {
                "additionalProperties": {},
                "description": "Inline structured output definition (get_api_schema: CreateStructuredOutputDTO)",
                "type": "object"
              },
              "structuredOutputId": {
                "description": "ID of an existing structured output to evaluate. Use this or structuredOutput.",
                "type": "string"
              },
              "value": {
                "description": "Expected value",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "comparator",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "instructions": {
          "description": "Script or instructions the tester follows during the simulation",
          "type": "string"
        },
        "name": {
          "description": "Name of the scenario",
          "type": "string"
        },
        "path": {
          "description": "Optional folder path for organizing, up to 3 levels (e.g. \"team/feature/variant\")",
          "type": "string"
        }
      },
      "required": [
        "name",
        "instructions",
        "evaluations"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_simulation_suite",
    "description": "Creates a simulation suite that groups simulations so they can be run together",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "additionalFields": {
          "additionalProperties": {},
          "description": "Other fields from the Vapi API, sent as given. Look them up with get_api_schema (CreateSimulationSuiteDTO).",
          "type": "object"
        },
        "name": {
          "description": "Name of the suite",
          "type": "string"
        },
        "path": {
          "description": "Optional folder path for organizing, up to 3 levels (e.g. \"team/feature/variant\")",
          "type": "string"
        },
        "simulationIds": {
          "description": "IDs of the simulations to include",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "simulationIds"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_tool",
    "description": "Creates a new Vapi tool",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "additionalFields": {
          "additionalProperties": {},
          "description": "Other top-level fields from the Vapi API for this tool type, such as messages or rejectionPlan, sent as given. Look them up with get_api_schema, e.g. CreateTransferCallToolDTO. On update_tool, each field given here replaces that whole field.",
          "type": "object"
        },
        "apiRequest": {
          "additionalProperties": false,
          "description": "API Request tool configuration - for HTTP API integration",
          "properties": {
            "backoffPlan": {
              "additionalProperties": false,
              "description": "Retry configuration for failed API requests",
              "properties": {
                "baseDelaySeconds": {
                  "default": 1,
                  "description": "Base delay between retries in seconds",
                  "type": "number"
                },
                "maxRetries": {
                  "default": 3,
                  "description": "Maximum number of retries",
                  "type": "number"
                },
                "type": {
                  "default": "fixed",
                  "enum": [
                    "fixed",
                    "exponential"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            "body": {
              "additionalProperties": false,
              "description": "Body schema for the API request in JSON Schema format",
              "properties": {
                "properties": {
                  "$ref": "#/properties/function/properties/parameters/properties/properties"
                },
                "required": {
                  "$ref": "#/properties/function/properties/parameters/properties/required"
                },
                "type": {
                  "$ref": "#/properties/function/properties/parameters/properties/type"
                }
              },
              "required": [
                "type",
                "properties"
              ],
              "type": "object"
            },
            "headers": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Headers to send with the request (key-value pairs)",
              "type": "object"
            },
            "method": {
              "default": "POST",
              "description": "HTTP method for the API request",
              "enum": [
                "GET",
                "POST"
              ],
              "type": "string"
            },
            "timeoutSeconds": {
              "default": 20,
              "description": "Request timeout in seconds",
              "type": "number"
            },
            "url": {
              "description": "URL to make the API request to",
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "type": "object"
        },
        "description": {
          "description": "Description of what the function/tool does",
          "type": "string"
        },
        "function": {
          "additionalProperties": false,
          "description": "Custom function tool configuration - for custom server-side functions",
          "properties": {
            "parameters": {
              "additionalProperties": false,
              "description": "JSON schema for function parameters",
              "properties": {
                "properties": {
                  "additionalProperties": {
                    "additionalProperties": false,
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "enum": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "items": {},
                      "properties": {
                        "additionalProperties": {},
                        "type": "object"
                      },
                      "required": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "type": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "type": "object"
                  },
                  "type": "object"
                },
                "required": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": {
                  "const": "object",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "properties"
              ],
              "type": "object"
            },
            "server": {
              "additionalProperties": false,
              "description": "Server configuration with URL where the function will be called",
              "properties": {
                "headers": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Headers to send with the request",
                  "type": "object"
                },
                "url": {
                  "description": "Server URL where the function will be called",
                  "format": "uri",
                  "type": "string"
                }
              },
              "required": [
                "url"
              ],
              "type": "object"
            }
          },
          "required": [
            "parameters",
            "server"
          ],
          "type": "object"
        },
        "name": {
          "description": "Name of the function/tool",
          "type": "string"
        },
        "sms": {
          "additionalProperties": false,
          "description": "SMS tool configuration - to send text messages",
          "properties": {
            "metadata": {
              "additionalProperties": false,
              "description": "SMS configuration metadata",
              "properties": {
                "from": {
                  "description": "Phone number to send SMS from (e.g., \"+15551234567\"). It must be a twilio number in E.164 format.",
                  "type": "string"
                }
              },
              "required": [
                "from"
              ],
              "type": "object"
            }
          },
          "required": [
            "metadata"
          ],
          "type": "object"
        },
        "transferCall": {
          "additionalProperties": false,
          "description": "Transfer call tool configuration - to transfer calls to destinations",
          "properties": {
            "destinations": {
              "description": "Array of possible transfer destinations",
              "items": {
                "additionalProperties": true,
                "description": "Transfer destination. Other TransferDestinationNumber fields, such as transferPlan and message, are sent as given (see get_api_schema).",
                "properties": {
                  "callerId": {
                    "description": "Caller ID to use for the transfer",
                    "type": "string"
                  },
                  "description": {
                    "description": "Description of the transfer destination",
                    "type": "string"
                  },
                  "extension": {
                    "description": "Extension number if applicable",
                    "type": "string"
                  },
                  "number": {
                    "description": "Phone number to transfer to (e.g., \"+16054440129\"). It can be any phone number in E.164 format.",
                    "type": "string"
                  },
                  "type": {
                    "const": "number",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "number"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "destinations"
          ],
          "type": "object"
        },
        "type": {
          "description": "Type of the tool to create",
          "enum": [
            "sms",
            "transferCall",
            "function",
            "apiRequest"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  },
  {
    "name": "get_api_schema",
    "description": "Looks up a schema in the Vapi API reference (the OpenAPI spec the Vapi SDKs are generated from). Pass `search` to find schema names, then `name` to get one schema. References to other schemas are left as \"#/components/schemas/<Name>\" and listed in referencedSchemas, so look those up next if you need them. Use it to find fields that other tools accept through additionalFields.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Exact schema name to return, e.g. \"CreateTransferCallToolDTO\" or \"TransferPlan\"",
          "type": "string"
        },
        "search": {
          "description": "Case-insensitive text to find schema names, e.g. \"transfer\". Used when name is not given.",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "get_assistant",
    "description": "Gets a Vapi assistant by ID",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "assistantId": {
          "description": "ID of the assistant to get",
          "type": "string"
        }
      },
      "required": [
        "assistantId"
      ],
      "type": "object"
    }
  },
  {
    "name": "get_call",
    "description": "Gets details of a specific call",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "callId": {
          "description": "ID of the call to get",
          "type": "string"
        }
      },
      "required": [
        "callId"
      ],
      "type": "object"
    }
  },
  {
    "name": "get_phone_number",
    "description": "Gets details of a specific phone number",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "phoneNumberId": {
          "description": "ID of the phone number to get",
          "type": "string"
        }
      },
      "required": [
        "phoneNumberId"
      ],
      "type": "object"
    }
  },
  {
    "name": "get_simulation_run",
    "description": "Gets a simulation run with its status, item counts, and each item’s status and evaluation results. Use get_simulation_run_item for an item’s transcript and call details.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "description": "ID of the simulation run",
          "type": "string"
        }
      },
      "required": [
        "runId"
      ],
      "type": "object"
    }
  },
  {
    "name": "get_simulation_run_item",
    "description": "Gets one simulation run item in full, including results, call snapshots, transcript, and improvement suggestions",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "itemId": {
          "description": "ID of the run item (from get_simulation_run)",
          "type": "string"
        },
        "runId": {
          "description": "ID of the simulation run",
          "type": "string"
        }
      },
      "required": [
        "runId",
        "itemId"
      ],
      "type": "object"
    }
  },
  {
    "name": "get_tool",
    "description": "Gets details of a specific tool",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "toolId": {
          "description": "ID of the tool to get",
          "type": "string"
        }
      },
      "required": [
        "toolId"
      ],
      "type": "object"
    }
  },
  {
    "name": "list_assistants",
