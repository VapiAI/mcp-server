  {
    "name": "list_calls",
    "description": "Lists all Vapi calls",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {},
      "type": "object"
    }
  },
  {
    "name": "list_phone_numbers",
    "description": "Lists all Vapi phone numbers",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {},
      "type": "object"
    }
  },
  {
    "name": "list_simulation_personalities",
    "description": "Lists simulation personalities: the simulated callers (testers) used in Vapi simulations",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Maximum number of results to return (default 50)",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "list_simulation_runs",
    "description": "Lists simulation runs, newest first",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Maximum number of results to return (default 50)",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "status": {
          "description": "Only runs with this status",
          "enum": [
            "queued",
            "running",
            "ended"
          ],
          "type": "string"
        },
        "targetId": {
          "description": "Only runs against this assistant or squad ID",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "list_simulation_scenarios",
    "description": "Lists simulation scenarios: the scripts testers follow and the checks that decide pass or fail",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Maximum number of results to return (default 50)",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "description": "Only scenarios with this name",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
