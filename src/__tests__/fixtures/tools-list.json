  {
    "name": "run_simulations",
    "description": "Starts a simulation run of simulations and/or suites against an assistant or squad. Returns the run with its ID and a dashboard URL to share with the user. Check progress with get_simulation_run.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "assistantId": {
          "description": "ID of the assistant to test. Give assistantId or squadId.",
          "type": "string"
        },
        "idempotencyKey": {
          "description": "Optional key that makes retries safe: a repeat request with the same key and body returns the original run instead of starting another",
          "type": "string"
        },
        "iterations": {
          "description": "How many times to run each simulation (default 1)",
          "minimum": 1,
          "type": "integer"
        },
        "simulationIds": {
          "description": "IDs of simulations to run",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "squadId": {
          "description": "ID of the squad to test. Give assistantId or squadId.",
          "type": "string"
        },
        "suiteIds": {
          "description": "IDs of simulation suites to run",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "transport": {
          "description": "vapi.websocket for a voice simulation, vapi.webchat for a chat simulation",
          "enum": [
            "vapi.websocket",
            "vapi.webchat"
          ],
          "type": "string"
        }
      },
      "type": "object"
    }
