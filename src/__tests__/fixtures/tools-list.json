                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "model": {
                      "enum": [
                        "claude-3-7-sonnet-20250219",
                        "claude-3-5-haiku-20241022"
                      ],
                      "type": "string"
                    },
                    "provider": {
                      "const": "anthropic",
                      "type": "string"
                    }
                  },
                  "required": [
                    "provider",
                    "model"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "model": {
                      "enum": [
                        "gemini-1.5-pro",
